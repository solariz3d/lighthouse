+
+// D411: extendCorner's kept answers (and solve's start) are kept by a key of the fields and only for a document frozen all the way down. JSON.stringify read
+// NaN as null, so a refused call was served the accepted call's answer; and Object.isFrozen(doc) read only the top, so a document whose pieces array was then
+// edited in place was served its old answer.
+test('row 7 (D411): a kept answer is never served to fields that only print alike (NaN, null), nor to a document frozen only at the top whose pieces then change', () => {
+  const refuses = (d, kh) => assert.throws(() => TB.extendCorner(d, { length: 400, targets: { kh } }), (e) => e.code === 'BAD_TARGET', `kh ${kh} is refused`);
+  refuses(straight(), NaN);
+  const d = straight();
+  assert.equal(TB.extendCorner(d, { length: 400, targets: { kh: null } }).pieces.length, 2);
+  refuses(d, NaN); refuses(d, Infinity);
+  for (const corner of [{}, { turnDeg: -45 }]) {
+    const full = eased90(straight()), top = Object.freeze({ ...full, pieces: [...full.pieces] }), opts = { length: 400, ...corner };
