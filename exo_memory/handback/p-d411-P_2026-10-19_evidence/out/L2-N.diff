+/** D411: the key a kept answer is found by, or null (not kept) for fields JSON would print alike when they are not alike. Only null, booleans, strings, finite
+ *  numbers but −0, arrays without holes and plain objects of those are keyed: NaN and ±Infinity print as null, −0 as 0, an undefined value as nothing. */
+function keyOf(v) {
+  const ok = (x) => {
+    if (x === null || typeof x === 'boolean' || typeof x === 'string') return true;
+    if (typeof x === 'number') return Number.isFinite(x) && !Object.is(x, -0);
+    if (typeof x !== 'object') return false;
+    if (Array.isArray(x)) { for (let i = 0; i < x.length; i++) if (!(i in x) || !ok(x[i])) return false; return true; }
+    const pr = Object.getPrototypeOf(x);
+    return (pr === Object.prototype || pr === null) && Object.keys(x).every((k) => ok(x[k]));
+  };
+  try { return ok(v) ? JSON.stringify(v) : null; } catch (e) { return null; }
+}
+/** D411: frozen all the way down (Object.isFrozen reads the top only: a pieces array edited in place is another document under the same object). A frozen
+ *  object stays frozen, so the ones found so are remembered and a document is walked once. */
+const DEEP = new WeakSet();
+function frozenDeep(o) {
+  if (!o || typeof o !== 'object' || DEEP.has(o)) return true;
+  if (!Object.isFrozen(o) || !Object.keys(o).every((k) => frozenDeep(o[k]))) return false;
+  DEEP.add(o);
+  return true;
+}
 
