+
+// The kept answers (D404: extendCorner's, and solve's start) are kept only for what they were made from: a field that JSON would write the same as another (NaN and
+// null both "null") is not the same call, and a document frozen at the top only can still have its pieces changed under it.
+test('row 7: a kept answer is never given for a different call: NaN is not null, and a document whose pieces were edited in place is solved again', () => {
+  const doc = straight(), refuses = (f) => assert.throws(f, (e) => e.code === 'BAD_TARGET' || e.code === 'NOT_FINITE', 'a NaN target is refused as on a fresh document');
+  refuses(() => TB.extendCorner(straight(), { length: 400, targets: { kh: NaN } }));
+  TB.extendCorner(doc, { length: 400, targets: { kh: null } });
+  refuses(() => TB.extendCorner(doc, { length: 400, targets: { kh: NaN } }));
+  refuses(() => TB.extendTurnBy(straight(), { length: 400, targets: { kv: NaN } }, 30 * DEG));
+  TB.extendTurnBy(doc, { length: 400, targets: { kv: null } }, 30 * DEG);
