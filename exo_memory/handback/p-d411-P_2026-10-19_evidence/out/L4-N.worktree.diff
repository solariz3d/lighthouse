+  assert.ok(during(ctx, () => e.tick({ midi: 84 })).sources.some((x) => x.slot === 'drag_tick'), 'the tick plays its sample');
+  assert.ok(during(ctx, () => e.loopClosed()).sources.some((x) => x.slot === 'loop_closed'), 'the loop close plays its sample');
+  // a file of the picked melody that fails still throws the samples out, as row 5
