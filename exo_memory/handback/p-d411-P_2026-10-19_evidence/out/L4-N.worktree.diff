+// D411: all ten files are fetched, but a launch plays one melody; a file of another melody that fails (a 404) must not throw out the samples it does play
+test('row 12: a 404 on a melody the launch did not pick costs nothing: the tick, the loop close and the picked melody play their samples, nothing logged', async () => {
+  const P = player({ pick: () => 0, fetchImpl: (url) => Promise.resolve({ ok: !url.includes('undo_glass'), status: url.includes('undo_glass') ? 404 : 200, arrayBuffer: () => Promise.resolve({ name: url }) }) });
