+  assert.deepEqual(P.logs, [], 'nothing to log');
+  const use = P.calls.find((c) => c[0] === 'useSamples');
+  assert.ok(use, 'the engine is handed the samples');
+  for (const f of ['drag_tick', 'loop_closed', 'place_aqua', 'undo_aqua']) assert.equal(use[1][f] && use[1][f].decoded, `sounds/${f}.wav`, `${f} is in the set`);
+  assert.ok(!use[1].undo_glass, 'the missing file is not');
