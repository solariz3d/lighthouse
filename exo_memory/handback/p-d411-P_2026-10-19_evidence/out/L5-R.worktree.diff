+// ── A DECLARED TIME BUDGET (2026-10-19) ──────────────────────────────────────────────────────
+// gen-consumer.test.js takes 123-157 s alone against a 120 s kill, so it CRASHED every full run.
+// A file may declare a longer budget in its header, capped at TIMEOUT_CAP x the default so the
+// declaration cannot buy a hang an unbounded life. Fixtures run with a 1 s default.
+const TMK = '// JS-SUITE:' + ' TIMEOUT-MS ';
+const SLOW = 'setTimeout(()=>{' + GREEN + '},2000);';
+const HANG = 'setInterval(()=>{},1000);';
+test('a slow file inside its DECLARED budget is green', () => {
+  const r = runWith(tree({ 'a.test.js': TMK + '3000\n' + SLOW }), { JS_SUITE_TIMEOUT_MS: '1000' });
+  assert.strictEqual(r.code, 0, r.out + r.err);
+  assert.ok(/1 green/.test(r.out), r.out);
+});
+test('the same slow file WITHOUT a declaration is still killed', () => {
+  const r = runWith(tree({ 'a.test.js': SLOW }), { JS_SUITE_TIMEOUT_MS: '1000' });
+  assert.strictEqual(r.code, 1, r.out);
+  assert.ok(/1 crashed/.test(r.out), r.out);
+});
+test('a HANG under a huge declared budget is still killed, at the cap', () => {
+  const t = Date.now();
+  const r = runWith(tree({ 'a.test.js': TMK + '999999999\n' + HANG }), { JS_SUITE_TIMEOUT_MS: '1000' });
+  assert.strictEqual(r.code, 1, r.out);
+  assert.ok(/1 crashed/.test(r.out), r.out);
+  assert.ok(Date.now() - t < 30000, `the cap did not bound the hang: ${Date.now() - t} ms`);
+});
+
