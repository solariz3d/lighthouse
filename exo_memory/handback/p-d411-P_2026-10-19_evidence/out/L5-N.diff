+// ── PER-FILE TIME BUDGET ─────────────────────────────────────────────────────────────────────────
+// gen-consumer.test.js takes 123-157 s alone and the runner killed every file at 120 s, so every
+// full run CRASHED on it. The fix may not hide a real hang: a declared budget is still a kill, it is
+// capped, and a kill says it was a timeout. These run with a 1.5 s default so the fixtures are fast.
+// Marker built by concatenation, for the reason MARK is.
+const BUDGET = (ms) => '// JS-SUITE:' + ' TIMEOUT-MS=' + ms + '\n';
+const SLOW = 'setTimeout(()=>{' + GREEN + '},3000);';
+const HANG = 'setInterval(()=>{},1000);';
+const FAST_ENV = { JS_SUITE_TIMEOUT_MS: '1500', JS_SUITE_MAX_TIMEOUT_MS: '10000' };
+
+test('BUDGET: a slow file with NO declaration is killed and reported as a TIMEOUT, not a bare crash', () => {
+  const r = runWith(tree({ 'a.test.js': SLOW }), FAST_ENV);
+  assert.strictEqual(r.code, 1, r.out);
+  assert.match(r.out, /1 crashed/, r.out);
+  assert.match(r.out, /TIMED OUT after 1500 ms/, 'a kill must name itself, or a hang reads like any crash:\n' + r.out);
+});
+
+test('BUDGET: a slow file that DECLARES a longer budget runs to green', () => {
+  const r = runWith(tree({ 'a.test.js': BUDGET(8000) + SLOW }), FAST_ENV);
+  assert.strictEqual(r.code, 0, r.out + r.err);
+  assert.match(r.out, /1 green/, r.out);
+  assert.match(r.out, /budget 8000 ms/, 'a raised budget is printed on the file\'s row, not granted silently:\n' + r.out);
+});
+
+test('BUDGET: a declared budget is still a kill — a file that HANGS is still crashed, as a timeout', () => {
+  const r = runWith(tree({ 'a.test.js': BUDGET(3000) + HANG }), FAST_ENV);
+  assert.strictEqual(r.code, 1, r.out);
+  assert.match(r.out, /1 crashed/, r.out);
+  assert.match(r.out, /TIMED OUT after 3000 ms/, r.out);
+});
+
+test('BUDGET: a budget above the cap is a CLASS ERROR, never honoured and never quietly clamped', () => {
+  const r = runWith(tree({ 'a.test.js': BUDGET(999999) + GREEN }), FAST_ENV);
+  assert.strictEqual(r.code, 1, r.out);
+  assert.match(r.out, /1 class-error/, r.out);
+  assert.match(r.out, /cap/i, r.out);
+});
+
+test('BUDGET: a malformed budget is a CLASS ERROR, not a fallback to the default', () => {
+  const r = runWith(tree({ 'a.test.js': BUDGET('soon') + GREEN }), FAST_ENV);
+  assert.strictEqual(r.code, 1, r.out);
+  assert.match(r.out, /1 class-error/, r.out);
+});
+
+test('BUDGET: gen-consumer.test.js declares a budget above the default and within the cap', () => {
+  const src = fs.readFileSync(TOOL, 'utf8');
+  const def = Number(src.match(/JS_SUITE_TIMEOUT_MS \|\| (\d+)/)[1]);
+  const cap = Number((src.match(/JS_SUITE_MAX_TIMEOUT_MS \|\| (\d+)/) || [])[1]);
+  const head = fs.readFileSync(path.join(__dirname, 'gen-consumer.test.js'), 'utf8').split('\n').slice(0, 40).join('\n');
+  const m = /^\s*\/\/\s*JS-SUITE:\s*TIMEOUT-MS=(\d+)\s*$/m.exec(head);
+  assert.ok(m, 'gen-consumer.test.js takes 123-157 s alone; it must declare its budget in its header');
+  assert.ok(Number(m[1]) > def && Number(m[1]) <= cap, `budget ${m[1]} must sit in (${def}, ${cap}]`);
+});
+
 console.log(`\njs-suite-self: ${pass} passed, ${fail} failed`);
