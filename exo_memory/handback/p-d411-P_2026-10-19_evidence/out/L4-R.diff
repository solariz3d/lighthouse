+
+// D411: the player loads only what its melody plays (the tick, the loop close, its place and undo), so a missing file of another melody costs nothing
+test('row 12: a launch fetches only its melody\'s files; a 404 on another melody\'s file does not keep the samples from playing', async () => {
+  for (const [i, m] of MELODY_NAMES.entries()) {
+    const own = ['drag_tick', 'loop_closed', `place_${m}`, `undo_${m}`], other = MELODY_NAMES.find((k) => k !== m);
+    const P = player({ pick: () => i / MELODY_NAMES.length, fetchImpl: (url) => Promise.resolve(url.includes(other) ? { ok: false, status: 404 } : { ok: true, status: 200, arrayBuffer: () => Promise.resolve({ name: url }) }) });
+    P.fire('pointerdown'); await settle(); await settle(); await settle();
+    assert.deepEqual(P.fetched, own.map((f) => `sounds/${f}.wav`), `${m}: only its own four files`);
+    assert.deepEqual(P.logs, [], `${m}: nothing to log`);
+    const use = P.calls.find((c) => c[0] === 'useSamples');
+    assert.ok(use, `${m}: the samples are used`); assert.deepEqual(Object.keys(use[1]).sort(), [...own].sort(), `${m}: the four it plays`);
+  }
+  const b = fakeBuffers(); for (const k of MELODY_NAMES.slice(1)) { delete b[`place_${k}`]; delete b[`undo_${k}`]; }
+  assert.doesNotThrow(() => createEngine(fakeCtx(), { melody: MELODY_NAMES[0] }).useSamples(b), 'an engine needs only its own melody\'s files');
+});
