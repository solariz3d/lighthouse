diff --git a/game/tests/anim_tests.cpp b/game/tests/anim_tests.cpp
index a76d82c..1197261 100644
--- a/game/tests/anim_tests.cpp
+++ b/game/tests/anim_tests.cpp
@@ -1015,3 +1015,44 @@ DZ_TEST(chain_the_turns_lean_follows_its_two_dials_the_share_and_the_ease) {
   DZ_CHECK(std::fabs(half.chest - 0.5f * src.chest) <= 0.3f);
   DZ_CHECK(src.half > 0.0f && std::fabs((slow.half - src.half) - (0.34f - 0.1126f)) <= 0.3f * (0.34f - 0.1126f));
 }
+
+// The idle made visible (his item 248, 02:27: "there is no idle animation for either"; the chair's ruling of 08:28Z): a whole body
+// standing still for two minutes shifts its weight between its feet as Duarte & Zatsiorsky 1999 found people do in natural standing
+// ("on average, one postural change was produced every 20 s", Duarte, Freitas & Zatsiorsky's chapter, read at source): its pelvis
+// moves across toward a foot (a shift: at least 1 cm within 5 s) 3 to 12 times in 120 s, over at least 2 cm in all (OURS: no source
+// read gives a shift's size; the still-standers' floor, dos Santos 2017, is a centre of pressure wandering 2.8 mm sd across), the chest
+// rolling with it, while both feet stay planted (each ankle within 1 cm of where it stood). Printed: the shifts, their reach, the
+// chest's roll, the feet.
+DZ_TEST(the_new_systems_body_standing_still_shifts_its_weight_between_its_feet) {
+  anim::Animator body(anim::kRunnerRow);
+  body.set_rest(plain_rest(1.0f));
+  anim::Intent in;
+  in.position = Vec3{0.0f, 0.0f, 0.0f}, in.velocity = Vec3{}, in.facing = 0.0f;
+  std::vector<float> across;
+  Vec3 ankle0[2]{};
+  float feet_moved = 0.0f, chest_roll = 0.0f;
+  const Vec3 right{1.0f, 0.0f, 0.0f};
+  for (int t = 0; t < static_cast<int>(122.0f / kDt); ++t) {
+    body.tick(in, {}, kDt);
+    const BodyPose p = body.pose(1.0f);
+    if (t * kDt < 2.0f) continue;
+    const Vec3 al = p[Joint::AnkleL], ar = p[Joint::AnkleR];
+    if (across.empty()) ankle0[0] = al, ankle0[1] = ar;
+    feet_moved = std::max({feet_moved, length(al - ankle0[0]), length(ar - ankle0[1])});
+    across.push_back(dot(p[Joint::Pelvis] - (ankle0[0] + ankle0[1]) * 0.5f, right));
+    chest_roll = std::max(chest_roll, std::fabs(roll_of(p[Joint::Chest], p[Joint::Neck], right)) / kDeg);
+  }
+  const size_t w = static_cast<size_t>(5.0f / kDt);
+  int shifts = 0;
+  for (size_t i = w; i < across.size();) {
+    if (std::fabs(across[i] - across[i - w]) >= 0.01f) ++shifts, i += w;   // one shift, then look again after it
+    else ++i;
+  }
+  const float reach = *std::max_element(across.begin(), across.end()) - *std::min_element(across.begin(), across.end());
+  std::printf("    standing 120 s: %d weight shifts (Duarte: one postural change every 20 s, so about 6), the pelvis over %.1f cm across (OURS;"
+              " the still-standers' floor: 2.8 mm sd), the chest rolling up to %.1f degrees, the feet moved at most %.1f mm\n",
+              shifts, static_cast<double>(reach * 100.0f), static_cast<double>(chest_roll), static_cast<double>(feet_moved * 1000.0f));
+  DZ_CHECK(shifts >= 3 && shifts <= 12);
+  DZ_CHECK(reach >= 0.02f);
+  DZ_CHECK(feet_moved <= 0.01f);
+}
